# Copy to .env.dev for `pnpm dev`. Never point NUXT_DATABASE_URL at the
# production database: migrations run automatically when the server starts.

NUXT_SESSION_PASSWORD=          # at least 32 characters
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google
NUXT_OPENAI_API_KEY=
NUXT_GOOGLE_PLACES_API_KEY=
# Local Postgres from docker-compose.yml (`pnpm db:up`)
NUXT_DATABASE_URL=postgresql://postgres@localhost:5432/mapmytrip
NUXT_ADMIN_EMAILS=              # who can manage /admin/places, comma separated
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NUXT_PUBLIC_GOOGLE_MAPS_MAP_ID= # optional
# Optional: traces of every generation in LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=map-my-trip
